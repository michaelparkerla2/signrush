{
  "name": "projects/signrush/locations/us-east1/services/signrush-worker",
  "description": "Private scheduled SignRush upload, review and consensus worker",
  "ingress": "INGRESS_TRAFFIC_ALL",
  "invokerIamDisabled": false,
  "scaling": {
    "maxInstanceCount": 1
  },
  "template": {
    "serviceAccount": "signrush-worker@signrush.iam.gserviceaccount.com",
    "timeout": "480s",
    "maxInstanceRequestConcurrency": 1,
    "scaling": {
      "maxInstanceCount": 1
    },
    "containers": [
      {
        "image": "us-east1-docker.pkg.dev/signrush/signrush-worker/worker:e9c294f",
        "env": [
          {
            "name": "WORKER_AUDIENCE",
            "value": "https://signrush-worker-3poiffqzca-ue.a.run.app"
          },
          {
            "name": "WORKER_CALLER",
            "value": "signrush-scheduler@signrush.iam.gserviceaccount.com"
          }
        ],
        "resources": {
          "limits": {
            "cpu": "1",
            "memory": "512Mi"
          },
          "cpuIdle": true
        },
        "ports": [
          {
            "name": "http1",
            "containerPort": 8080
          }
        ],
        "startupProbe": {
          "timeoutSeconds": 2,
          "periodSeconds": 5,
          "failureThreshold": 20,
          "httpGet": {
            "path": "/healthz",
            "port": 8080
          }
        }
      }
    ]
  }
}
