rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function enrolledAccount(uid) {
   return request.auth != null && request.auth.uid == uid
    && request.auth.token.email_verified == true
    && request.auth.token.firebase.sign_in_provider == 'google.com'
    && (!exists(/databases/$(database)/documents/pilotInvites/$(uid))
     || get(/databases/$(database)/documents/pilotInvites/$(uid)).data.active == true);
  }
  function profileShape(d, uid) {
   return d.keys().hasAll(['uid','createdAt','updatedAt','status','mode','lastConsentId','consentAccepted'])
    && d.keys().hasOnly(['uid','createdAt','updatedAt','status','mode','lastConsentId','consentAccepted'])
    && d.uid == uid && d.mode == 'test' && d.consentAccepted is bool;
  }
  function currentConsent(d) {
   return d.termsVersion == 'terms-2026-09-26-v3'
    && d.disclosureVersion == 'commercial-2026-09-26-v2'
    && d.privacyVersion == 'privacy-2026-09-26-v2'
    && d.bundleHash == '3cd7079cf5b9a988b9480309dee50f633061ef8235865e504b9d82b0a3b33fde'
    && d.adultConfirmed == true && d.publicDisplayAllowed == false;
  }
  function eventShape(d) {
   return d.keys().hasAll(['action','termsVersion','disclosureVersion','privacyVersion','bundleHash','recordedAt','uid','email','adultConfirmed','publicDisplayAllowed'])
    && d.keys().hasOnly(['action','termsVersion','disclosureVersion','privacyVersion','bundleHash','recordedAt','uid','email','adultConfirmed','publicDisplayAllowed'])
    && d.action in ['accepted','withdrawn']
    && d.termsVersion == 'terms-2026-09-26-v3' && d.disclosureVersion == 'commercial-2026-09-26-v2'
    && d.privacyVersion == 'privacy-2026-09-26-v2' && d.bundleHash == '3cd7079cf5b9a988b9480309dee50f633061ef8235865e504b9d82b0a3b33fde'
    && d.uid == request.auth.uid && d.email == request.auth.token.email
    && d.adultConfirmed == (d.action == 'accepted') && d.publicDisplayAllowed == false
    && d.recordedAt == request.time;
  }
  function participating(uid) {
   return enrolledAccount(uid)
    && get(/databases/$(database)/documents/players/$(uid)).data.status == 'active'
    && get(/databases/$(database)/documents/players/$(uid)).data.mode == 'test'
    && get(/databases/$(database)/documents/players/$(uid)).data.consentAccepted == true
    && get(/databases/$(database)/documents/players/$(uid)/consents/$(get(/databases/$(database)/documents/players/$(uid)).data.lastConsentId)).data.action == 'accepted'
    && currentConsent(get(/databases/$(database)/documents/players/$(uid)/consents/$(get(/databases/$(database)/documents/players/$(uid)).data.lastConsentId)).data);
  }
  match /contributorProfiles/{uid} {
   allow get: if enrolledAccount(uid);
   allow list, delete: if false;
   allow create, update: if enrolledAccount(uid)
    && request.resource.data.keys().hasOnly(['aslExperience','hearingIdentity','aslRole','updatedAt','consentId'])
    && request.resource.data.aslExperience in ['unspecified','learning','conversational','fluent','native']
    && request.resource.data.hearingIdentity in ['unspecified','deaf','hard_of_hearing','hearing','self_described']
    && request.resource.data.aslRole in ['unspecified','signer','learner','interpreter','translator','educator','other']
    && request.resource.data.updatedAt == request.time
    && getAfter(/databases/$(database)/documents/players/$(uid)).data.lastConsentId == request.resource.data.consentId
    && getAfter(/databases/$(database)/documents/players/$(uid)/consents/$(request.resource.data.consentId)).data.recordedAt == request.time
    && currentConsent(getAfter(/databases/$(database)/documents/players/$(uid)/consents/$(request.resource.data.consentId)).data);
  }
  match /privacyRequests/{id} {
   // Requests remain available after consent withdrawal; no participation check.
   allow create: if request.auth != null && request.auth.token.email_verified == true
    && request.resource.data.keys().hasOnly(['uid','kind','details','status','createdAt'])
    && request.resource.data.uid == request.auth.uid
    && request.resource.data.kind in ['access','correction','deletion','restriction']
    && request.resource.data.details is string && request.resource.data.details.size() <= 2000
    && request.resource.data.status == 'requested' && request.resource.data.createdAt == request.time;
   allow get: if request.auth != null && resource.data.uid == request.auth.uid;
   allow list, update, delete: if false;
  }
  function dailyPrompt(id) {
   return id == "DAILY-001" ? "I need help."
    : id == "DAILY-002" ? "I can help you."
    : id == "DAILY-003" ? "Please wait a moment."
    : id == "DAILY-004" ? "Please come here."
    : id == "DAILY-005" ? "Please sit down."
    : id == "DAILY-006" ? "Where is the bathroom?"
    : id == "DAILY-007" ? "Please sign that again."
    : id == "DAILY-008" ? "Please sign more slowly."
    : id == "DAILY-009" ? "I understand."
    : id == "DAILY-010" ? "I do not understand."
    : id == "DAILY-011" ? "I need some water."
    : id == "DAILY-012" ? "I am hungry."
    : id == "DAILY-013" ? "I am tired."
    : id == "DAILY-014" ? "I need a break."
    : id == "DAILY-015" ? "I am ready."
    : id == "DAILY-016" ? "I am not ready yet."
    : id == "DAILY-017" ? "Please open the door."
    : id == "DAILY-018" ? "Please close the door."
    : id == "DAILY-019" ? "Please turn on the light."
    : id == "DAILY-020" ? "Please turn off the light."
    : id == "DAILY-021" ? "Please give me the cup."
    : id == "DAILY-022" ? "Please put the cup on the table."
    : id == "DAILY-023" ? "Please bring me my bag."
    : id == "DAILY-024" ? "Please leave the bag here."
    : id == "DAILY-025" ? "Where is my phone?"
    : id == "DAILY-026" ? "Where are my keys?"
    : id == "DAILY-027" ? "What time are we leaving?"
    : id == "DAILY-028" ? "I need to go home."
    : id == "DAILY-029" ? "I will come back tomorrow."
    : id == "DAILY-030" ? "Thank you for helping me."
    : "";
  }
  function knownDailyPrompt(id, text) {
   return text is string && dailyPrompt(id) == text && text.size() > 0;
  }
  function signerInstruction() {
   return "Express this meaning naturally in ASL, as you would in an everyday conversation. You do not need to follow the English word order. Use your own natural signing style.";
  }
  function claimJob(d, uid) {
   return d.keys().hasOnly(['uid','state','requestedAt','assignmentId','promptId','prompt','promptVersion','signerInstruction','maxBytes','maxSeconds','batch'])
    && d.uid == uid && d.state == 'assigned' && d.assignmentId.matches('^[a-f0-9]{32}$')
    && d.requestedAt == request.time && d.promptVersion == 1 && d.batch == 'daily-use-v1'
    && d.maxBytes == 8388608 && d.maxSeconds == 30 && d.signerInstruction == signerInstruction()
    && knownDailyPrompt(d.promptId, d.prompt);
  }
  function claimAgrees(uid) {
   let job = request.resource.data;
   let recording = getAfter(/databases/$(database)/documents/pilotRecordings/$(job.assignmentId)).data;
   let activity = getAfter(/databases/$(database)/documents/pilotActivity/$(uid)).data;
   let coverage = getAfter(/databases/$(database)/documents/promptCoverage/daily-use-v1).data;
   let limits = getAfter(/databases/$(database)/documents/pilotLimits/daily-use-v1).data;
   return job.uid == uid && recording.uid == uid && recording.status == 'assigned'
    && recording.assignmentId == job.assignmentId && recording.phrase.id == job.promptId
    && recording.phrase.text == job.prompt && activity.signingPhraseIds.hasAny([job.promptId])
    && coverage.claimId == job.assignmentId && coverage[job.promptId] is int
    && limits.claimId == job.assignmentId && limits.reserved is int && limits.reserved <= 300 && limits.limit == 300;
  }
  match /signingJobs/{uid} {
   allow get: if participating(uid);
   allow list, delete: if false;
   allow create: if participating(uid) && (
    (request.resource.data.keys().hasOnly(['uid','state','requestedAt'])
     && request.resource.data.uid == uid && request.resource.data.state == 'requested'
     && request.resource.data.requestedAt == request.time)
    || (claimJob(request.resource.data, uid) && claimAgrees(uid)));
   allow update: if participating(uid) && (
    (resource.data.state in ['saved','failed','blocked']
     && request.resource.data.keys().hasOnly(['uid','state','requestedAt'])
     && request.resource.data.uid == uid && request.resource.data.state == 'requested'
     && request.resource.data.requestedAt == request.time)
    || (resource.data.state in ['requested','saved','failed','blocked']
     && claimJob(request.resource.data, uid) && claimAgrees(uid))
    || (resource.data.state == 'assigned' && request.resource.data.state == 'upload_requested'
     && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['state','size','mime','sha256'])
     && request.resource.data.size is int && request.resource.data.size > 0 && request.resource.data.size <= 8388608
     && request.resource.data.mime in ['video/webm','video/mp4']
     && request.resource.data.sha256.matches('^[a-f0-9]{64}$'))
    || (resource.data.state == 'uploading' && request.resource.data.state == 'submitted'
     && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['state']))
   );
  }
  match /reviewJobs/{uid} {
   allow get: if participating(uid);
   allow list, delete: if false;
   function requestShape(d) {
    return d.keys().hasOnly(['uid','state','requestedAt']) && d.uid == uid
     && d.state == 'requested' && d.requestedAt == request.time;
   }
   allow create: if participating(uid) && requestShape(request.resource.data);
   allow update: if participating(uid) && (
    (resource.data.state in ['empty','pending','blocked'] && requestShape(request.resource.data))
    || (resource.data.state == 'assigned' && request.resource.data.state == 'refresh_requested'
     && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['state']))
    || (resource.data.state == 'assigned' && request.resource.data.state == 'submitted'
     && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['state','text','submittedAt','quality','reportReason'])
     && request.resource.data.quality in ['good','poor','not_sure']
     && request.resource.data.text is string && request.resource.data.submittedAt == request.time
     && ((request.resource.data.get('reportReason','') == '' && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000)
      || (request.resource.data.get('reportReason','') in ['not_signing','unusable_quality'] && request.resource.data.text == '' && request.resource.data.quality == 'poor')))
   );
  }
  function gameShape(d) {
   return d.alias is string && d.alias.matches('^[A-Za-z][A-Za-z0-9 _-]{2,19}$')
    && d.avatar in ['sprout','orbit','blaze','ripple','nova','comet','peach','pixel']
    && d.updatedAt == request.time;
  }
  match /gameProfiles/{uid} {
   allow get, delete: if enrolledAccount(uid);
   allow list: if false;
   allow create, update: if participating(uid)
    && request.resource.data.keys().hasOnly(['alias','avatar','listed','updatedAt'])
    && gameShape(request.resource.data) && request.resource.data.listed is bool
    && (request.resource.data.listed || !existsAfter(/databases/$(database)/documents/leaderboard/$(uid)));
  }
  match /leaderboard/{uid} {
   allow get: if enrolledAccount(uid) || (request.auth != null && participating(request.auth.uid));
   allow list: if request.auth != null && participating(request.auth.uid) && request.query.limit <= 50;
   allow delete: if enrolledAccount(uid);
   allow create, update: if participating(uid)
    && getAfter(/databases/$(database)/documents/players/$(uid)).data.consentAccepted == true
    && request.resource.data.keys().hasOnly(['alias','avatar','points','updatedAt'])
    && gameShape(request.resource.data)
    && getAfter(/databases/$(database)/documents/gameProfiles/$(uid)).data.listed == true
    && request.resource.data.alias == getAfter(/databases/$(database)/documents/gameProfiles/$(uid)).data.alias
    && request.resource.data.avatar == getAfter(/databases/$(database)/documents/gameProfiles/$(uid)).data.avatar
    && request.resource.data.points is int && request.resource.data.points >= 0
    && request.resource.data.points == (exists(/databases/$(database)/documents/playerRewards/$(uid))
     ? get(/databases/$(database)/documents/playerRewards/$(uid)).data.points : 0);
  }
  match /payoutPreferences/{uid} {
   allow get, delete: if enrolledAccount(uid);
   allow list: if false;
   allow create, update: if participating(uid)
    && request.resource.data.keys().hasAll(['method','destination','usResident','version','updatedAt'])
    && request.resource.data.keys().hasOnly(['method','destination','usResident','version','updatedAt'])
    && request.resource.data.version == 1
    && request.resource.data.updatedAt == request.time
    && request.resource.data.destination is string
    && request.resource.data.usResident is bool
    && ((request.resource.data.method == 'paypal'
      && request.resource.data.usResident == false
      && request.resource.data.destination.size() <= 254
      && request.resource.data.destination.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$'))
     || (request.resource.data.method == 'venmo'
      && request.resource.data.usResident == true
      && request.resource.data.destination.matches('^[A-Za-z0-9_-]{5,30}$')));
  }
  match /playerDashboard/{uid} {
   allow get: if participating(uid);
   allow list, write: if false;
  }
  match /playerModeration/{uid} {
   allow get: if enrolledAccount(uid);
   allow list, write: if false;
  }
  match /playerRewards/{uid} {
   allow get: if enrolledAccount(uid);
   allow list, write: if false;
  }
  match /players/{uid} {
   allow get: if enrolledAccount(uid);
   allow list, delete: if false;
   allow create: if enrolledAccount(uid) && profileShape(request.resource.data, uid)
    && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time
    && request.resource.data.status == 'active'
    && request.resource.data.lastConsentId == null && request.resource.data.consentAccepted == false;
   allow update: if enrolledAccount(uid) && profileShape(request.resource.data, uid)
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updatedAt','lastConsentId','consentAccepted'])
    && request.resource.data.updatedAt == request.time
    && request.resource.data.lastConsentId is string
    && request.resource.data.lastConsentId.matches('^[A-Za-z0-9_-]{1,80}$')
    && request.resource.data.lastConsentId != resource.data.lastConsentId
    && !exists(/databases/$(database)/documents/players/$(uid)/consents/$(request.resource.data.lastConsentId))
    && eventShape(getAfter(/databases/$(database)/documents/players/$(uid)/consents/$(request.resource.data.lastConsentId)).data)
    && request.resource.data.consentAccepted ==
      (getAfter(/databases/$(database)/documents/players/$(uid)/consents/$(request.resource.data.lastConsentId)).data.action == 'accepted')
    && (resource.data.status == 'active' || request.resource.data.consentAccepted == false)
    && (request.resource.data.consentAccepted || !existsAfter(/databases/$(database)/documents/leaderboard/$(uid)));
   match /consents/{eventId} {
    allow get: if enrolledAccount(uid);
    allow list, update, delete: if false;
    allow create: if enrolledAccount(uid) && eventId.matches('^[A-Za-z0-9_-]{1,80}$')
     && eventShape(request.resource.data)
     && exists(/databases/$(database)/documents/players/$(uid))
     && getAfter(/databases/$(database)/documents/players/$(uid)).data.lastConsentId == eventId
     && getAfter(/databases/$(database)/documents/players/$(uid)).data.updatedAt == request.time
     && getAfter(/databases/$(database)/documents/players/$(uid)).data.consentAccepted == (request.resource.data.action == 'accepted');
   }
  }
  function currentClaim() {
   return getAfter(/databases/$(database)/documents/signingJobs/$(request.auth.uid)).data;
  }
  match /pilotActivity/{uid} {
   allow get: if participating(uid);
   allow list, delete: if false;
   allow create: if participating(uid)
    && request.resource.data.keys().hasOnly(['signingPhraseIds'])
    && request.resource.data.signingPhraseIds.size() == 1
    && currentClaim().state == 'assigned'
    && request.resource.data.signingPhraseIds[0] == currentClaim().promptId;
   allow update: if participating(uid) && activityClaim(uid);
  }
  function activityClaim(uid) {
   let job = currentClaim();
   let previous = resource.data.get('signingPhraseIds', []);
   let next = request.resource.data.signingPhraseIds;
   return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['signingPhraseIds'])
    && job.state == 'assigned' && job.uid == uid
    && next.size() == previous.size() + 1 && next.hasAll(previous)
    && !previous.hasAny([job.promptId]) && next.hasAny([job.promptId]);
  }
  match /pilotRecordings/{assignmentId} {
   allow get, list, update, delete: if false;
   allow create: if recordingClaim(assignmentId);
  }
  function recordingClaim(assignmentId) {
   let data = request.resource.data;
   let job = currentClaim();
   return participating(data.uid) && data.uid == request.auth.uid
    && data.keys().hasOnly(['uid','assignmentId','phrase','status','createdAt','consentVersion','mode','promptVersion','batch','corpusSignerId'])
    && data.assignmentId == assignmentId && data.assignmentId == job.assignmentId
    && data.status == 'assigned' && data.createdAt == request.time
    && data.consentVersion == 'training-v1' && data.mode == 'test' && data.promptVersion == 1
    && data.batch == 'daily-use-v1' && data.corpusSignerId == request.auth.uid
    && job.state == 'assigned' && job.promptId == data.phrase.id && job.prompt == data.phrase.text
    && data.phrase.keys().hasOnly(['id','version','text','signerInstruction','batch'])
    && data.phrase.version == 1 && data.phrase.batch == 'daily-use-v1'
    && data.phrase.signerInstruction == signerInstruction()
    && knownDailyPrompt(data.phrase.id, data.phrase.text);
  }
  match /promptCoverage/{batch} {
   allow get: if batch == 'daily-use-v1' && participating(request.auth.uid);
   allow list, delete: if false;
   allow create: if batch == 'daily-use-v1' && coverageCreate();
   allow update: if batch == 'daily-use-v1' && coverageUpdate();
  }
  function coverageCreate() {
   let job = currentClaim();
   let id = job.promptId;
   return job.state == 'assigned' && knownDailyPrompt(id, job.prompt)
    && request.resource.data.keys().hasOnly([id, 'claimId'])
    && request.resource.data[id] == 1 && request.resource.data.claimId == job.assignmentId;
  }
  function coverageUpdate() {
   let job = currentClaim();
   let id = job.promptId;
   return job.state == 'assigned' && knownDailyPrompt(id, job.prompt)
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly([id, 'claimId'])
    && request.resource.data[id] == resource.data.get(id, 0) + 1
    && request.resource.data[id] <= 10
    && request.resource.data.claimId == job.assignmentId
    && request.resource.data.claimId != resource.data.get('claimId', '');
  }
  match /pilotLimits/{batch} {
   allow get: if batch == 'daily-use-v1' && participating(request.auth.uid);
   allow list, delete: if false;
   allow create: if batch == 'daily-use-v1' && limitsCreate();
   allow update: if batch == 'daily-use-v1' && limitsUpdate();
  }
  function limitsCreate() {
   let job = currentClaim();
   return job.state == 'assigned'
    && request.resource.data.keys().hasOnly(['reserved','limit','claimId'])
    && request.resource.data.reserved == 1 && request.resource.data.limit == 300
    && request.resource.data.claimId == job.assignmentId;
  }
  function limitsUpdate() {
   let job = currentClaim();
   return job.state == 'assigned'
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reserved','claimId'])
    && request.resource.data.reserved == resource.data.reserved + 1
    && request.resource.data.reserved <= 300 && request.resource.data.limit == 300
    && request.resource.data.claimId == job.assignmentId
    && request.resource.data.claimId != resource.data.get('claimId', '');
  }
  // Invitations, prompts, answers, rewards, exports and every future collection
  // stay inaccessible to browser clients until separately designed and tested.
  match /{document=**} { allow read, write: if false; }
 }
}
